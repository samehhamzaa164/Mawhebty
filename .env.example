# قاعدة البيانات المحلية (تُنشأ تلقائيًا)
DATABASE_PATH=./data/mawhebty.db

# سر توقيع الجلسات — غيّره في الإنتاج إلى قيمة عشوائية طويلة
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# مفتاح الذكاء الاصطناعي (اختياري). بدونه يعمل مساعد نوري بوضع المحادثة الآمن المحلي.
# يدعم أي مزود متوافق مع OpenAI Chat Completions.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# أو استخدم Google Gemini مباشرة
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# رابط الموقع العام (للإنتاج)
NEXT_PUBLIC_APP_URL=http://localhost:3000
